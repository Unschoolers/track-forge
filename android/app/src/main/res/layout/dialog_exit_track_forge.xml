<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/trackforge_dialog_surface">

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FF7846" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/exit_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exit_track_forge_title"
            android:textColor="#EDF2F8"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold|italic"
            android:textSize="27sp"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/exit_track_forge_message"
            android:textColor="#AAB9C8"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/exit_dialog_stay"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/trackforge_dialog_button_secondary"
                android:backgroundTint="@null"
                android:fontFamily="monospace"
                android:text="@string/exit_track_forge_stay"
                android:textAllCaps="false"
                android:textColor="#EDF2F8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/exit_dialog_confirm"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/trackforge_dialog_button_primary"
                android:backgroundTint="@null"
                android:fontFamily="monospace"
                android:text="@string/exit_track_forge_exit"
                android:textAllCaps="false"
                android:textColor="#101017"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
