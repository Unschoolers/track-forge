{
  "name": "trackforge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TrackForge racing game and track editor",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "npm run test:fast && npm run test:ai:matrix",
    "test:watch": "vitest",
    "qa:mobile": "playwright test --config=playwright.mobile.config.mjs",
    "qa:mobile:production": "playwright test --config=playwright.production.config.mjs",
    "qa:lanes": "node qa/lanes/cli.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint . --max-diagnostics=250",
    "build": "npm run typecheck && vite build",
    "verify": "npm test && npm run lint && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "qa:race": "node qa/race-analysis/cli.mjs",
    "qa:race:test": "node --test qa/race-analysis/*.check.mjs",
    "qa:optimize": "node qa/optimization/cli.mjs",
    "qa:optimize:test": "node --test qa/optimization/*.test.mjs qa/optimization/balance/*.test.mjs",
    "test:fast": "vitest run --exclude tests/domain/aiFourCarHardImprovements.test.ts",
    "test:ai:matrix": "vitest run tests/domain/aiFourCarHardImprovements.test.ts --maxWorkers=1",
    "qa:ai:benchmark": "AI_BENCHMARK=1 vitest run qa/lanes/aiFourCarHardImprovements.benchmark.ts --maxWorkers=1",
    "qa:ai:sweep": "AI_BENCHMARK=1 vitest run qa/lanes/aiHardProfileSweep.benchmark.ts --maxWorkers=1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
